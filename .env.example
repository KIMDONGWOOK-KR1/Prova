# CHEETAH GPU 서버 접속 정보 (예시)
#
# 이 파일을 .env 로 복사해 실제 값을 채운다. .env 는 .gitignore 대상이다.
# 저장소가 public 이라 실제 주소·계정을 커밋하지 않는다 — 키가 없으면 접속은 못
# 하지만, 학교 인프라 주소를 공개하면 불필요한 공격 표면이 된다.
#
# 실제 값은 팀 채널에서 공유한다.

CHEETAH_HOST=<cheetah-host>
CHEETAH_PORT=<port>
CHEETAH_USER=<user>
CHEETAH_KEY=private.pem

# 터널 열기:
#   ssh -N -L 8000:localhost:8000 -i $CHEETAH_KEY -p $CHEETAH_PORT $CHEETAH_USER@$CHEETAH_HOST
