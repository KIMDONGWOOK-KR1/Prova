{
  "screen_id": "contact",
  "screen_name": "문의하기",
  "url_path": "/contact",
  "elements": [
    {
      "element_id": "name",
      "type": "input",
      "label": "이름",
      "required": true,
      "constraints": {
        "min_length": 2,
        "max_length": 20
      },
      "error_message": "이름은 2자 이상 20자 이하로 입력하세요.",
      "placeholder": "이름을 입력하세요",
      "options": [],
      "sample_value": "홍길동"
    },
    {
      "element_id": "email",
      "type": "input",
      "label": "이메일",
      "required": true,
      "constraints": {
        "format": "email"
      },
      "error_message": "올바른 이메일 형식을 입력하세요.",
      "placeholder": "답변받을 이메일을 입력하세요",
      "options": [],
      "sample_value": "user@test.com"
    },
    {
      "element_id": "phone",
      "type": "input",
      "label": "연락처",
      "required": true,
      "constraints": {
        "pattern": "^010-\\d{4}-\\d{4}$"
      },
      "error_message": "연락처는 010-0000-0000 형식으로 입력하세요.",
      "placeholder": "휴대폰 번호를 입력하세요",
      "options": [],
      "sample_value": "010-1234-5678"
    },
    {
      "element_id": "category",
      "type": "select",
      "label": "문의 유형",
      "required": true,
      "constraints": {},
      "error_message": "문의 유형을 선택하세요.",
      "placeholder": null,
      "options": ["결제", "배송", "환불", "기타"],
      "sample_value": "결제"
    },
    {
      "element_id": "content",
      "type": "input",
      "label": "문의 내용",
      "required": true,
      "constraints": {
        "min_length": 10,
        "max_length": 500
      },
      "error_message": "문의 내용은 10자 이상 500자 이하로 입력하세요.",
      "placeholder": "문의 내용을 10자 이상 입력하세요",
      "options": [],
      "sample_value": "결제가 두 번 되었습니다. 확인 부탁드립니다."
    },
    {
      "element_id": "agree_privacy",
      "type": "checkbox",
      "label": "개인정보 수집 동의",
      "required": true,
      "constraints": {},
      "error_message": "개인정보 수집에 동의해야 합니다.",
      "placeholder": null,
      "options": [],
      "sample_value": null
    },
    {
      "element_id": "submit_btn",
      "type": "button",
      "label": "문의 접수",
      "required": false,
      "constraints": {},
      "error_message": null,
      "placeholder": null,
      "options": [],
      "sample_value": null
    }
  ],
  "scenarios": [],
  "success_condition": "같은 화면에 \"문의가 접수되었습니다. 답변은 입력하신 이메일로 보내 드립니다.\" 문구를 노출한다",
  "failure_conditions": [
    "필수 입력 항목입니다.",
    "이름은 2자 이상 20자 이하로 입력하세요.",
    "올바른 이메일 형식을 입력하세요.",
    "연락처는 010-0000-0000 형식으로 입력하세요.",
    "문의 내용은 10자 이상 500자 이하로 입력하세요.",
    "개인정보 수집에 동의해야 합니다."
  ],
  "required_message": "필수 입력 항목입니다.",
  "warnings": []
}
