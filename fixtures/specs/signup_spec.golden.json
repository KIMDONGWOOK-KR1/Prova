{
  "screen_id": "signup",
  "screen_name": "회원가입",
  "url_path": "/signup",
  "elements": [
    {
      "element_id": "email",
      "type": "input",
      "label": "이메일",
      "required": true,
      "constraints": {
        "format": "email"
      },
      "error_message": "올바른 이메일 형식을 입력하세요.",
      "sample_value": "newuser@test.com"
    },
    {
      "element_id": "password",
      "type": "input",
      "label": "비밀번호",
      "required": true,
      "constraints": {
        "min_length": 8,
        "require_uppercase": 1,
        "require_special": 1
      },
      "error_message": "비밀번호는 8자 이상이며 대문자·특수문자를 각 1자 이상 포함해야 합니다.",
      "sample_value": "Signup1!"
    },
    {
      "element_id": "password_confirm",
      "type": "input",
      "label": "비밀번호 확인",
      "required": true,
      "constraints": {
        "same_as": "password"
      },
      "error_message": "비밀번호가 일치하지 않습니다."
    },
    {
      "element_id": "nickname",
      "type": "input",
      "label": "닉네임",
      "required": true,
      "constraints": {
        "min_length": 2,
        "max_length": 10
      },
      "error_message": "닉네임은 2자 이상 10자 이하로 입력하세요.",
      "sample_value": "테스터"
    },
    {
      "element_id": "signup_path",
      "type": "select",
      "label": "가입 경로",
      "required": true,
      "constraints": {},
      "options": ["검색", "지인 추천", "광고"],
      "error_message": "가입 경로를 선택하세요."
    },
    {
      "element_id": "agree_terms",
      "type": "checkbox",
      "label": "약관 동의",
      "required": true,
      "constraints": {},
      "error_message": "약관에 동의해야 합니다."
    },
    {
      "element_id": "signup_btn",
      "type": "button",
      "label": "가입하기",
      "required": false,
      "constraints": {},
      "error_message": null
    }
  ],
  "success_condition": "/welcome 으로 이동하고 \"가입이 완료되었습니다\" 문구를 노출한다",
  "failure_conditions": [
    "필수 입력값이 비어 있으면 \"필수 입력 항목입니다.\" 노출, 이동하지 않음",
    "이메일 형식이 올바르지 않으면 \"올바른 이메일 형식을 입력하세요.\" 노출, 이동하지 않음",
    "비밀번호 검증 규칙 위반 시 \"비밀번호는 8자 이상이며 대문자·특수문자를 각 1자 이상 포함해야 합니다.\" 노출, 이동하지 않음",
    "비밀번호 확인이 비밀번호와 다르면 \"비밀번호가 일치하지 않습니다.\" 노출, 이동하지 않음",
    "닉네임 길이 규칙 위반 시 \"닉네임은 2자 이상 10자 이하로 입력하세요.\" 노출, 이동하지 않음",
    "가입 경로를 선택하지 않으면 \"가입 경로를 선택하세요.\" 노출, 이동하지 않음",
    "약관에 동의하지 않으면 \"약관에 동의해야 합니다.\" 노출, 이동하지 않음"
  ],
  "required_message": "필수 입력 항목입니다.",
  "warnings": []
}
