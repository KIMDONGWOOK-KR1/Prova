    },
    {
      "element_id": "visit_date",
      "type": "select",
      "label": "방문 날짜",
      "required": true,
      "constraints": {},
      "error_message": "방문 날짜를 선택하세요.",
      "placeholder": null,
      "options": [
        "2026-10-15",
        "2026-10-16",
        "2026-10-17"
      ],
      "sample_value": "2026-10-15"
    },
    {
      "element_id": "visit_time",
      "type": "select",
      "label": "방문 시간",
      "required": true,
      "constraints": {},
